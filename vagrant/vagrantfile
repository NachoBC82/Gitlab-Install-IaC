# -*- mode: ruby -*-
# vi: set ft=ruby :

require "yaml"


# Directorio Vagrant
vagrant_root = File.dirname(File.expand_path(__FILE__))
settings = YAML.load_file("#{vagrant_root}/settings.yaml")

# Sección de IPs
IP_SECTIONS = settings["network"]["control_ip"].match(/^([0-9.]+.)([^.]+)$/)
IP_NW = IP_SECTIONS.captures[0]
IP_START = Integer(IP_SECTIONS.captures[1])
NUM_WORKER_NODES = settings["nodes"]["workers"]["count"]

# Configuración de las máquinas Vagrant
Vagrant.configure("2") do |config|
  
  # Fijando arquitecturas de las máquina en base a la máquina local
  if RbConfig::CONFIG['host_cpu'] =~ /arm|aarch64/
    config.vm.box = settings["software"]["box"] + "-arm64"
  else
    config.vm.box = settings["software"]["box"]
  end
  config.vm.box_check_update = true

  # 1. CONTROLPLANE
  config.vm.define "controlplane" do |control|
    # Fijamos IP del Host
    control.vm.hostname = "controlplane"
    control.vm.network "private_network", ip: settings["network"]["control_ip"]
    
    # Fijamos carpetas compartidas por las máquinas virtuales
    if settings["shared_folders"]
      settings["shared_folders"].each do |sf|
        control.vm.synced_folder sf["host_path"], sf["vm_path"]
      end
    end

    # Fijamos recursos de la máquina virtual
    control.vm.provider "virtualbox" do |vb|
      vb.cpus = settings["nodes"]["control"]["cpu"]
      vb.memory = settings["nodes"]["control"]["memory"]
      if settings["cluster_name"] && settings["cluster_name"] != ""
        vb.customize ["modifyvm", :id, "--groups", ("/" + settings["cluster_name"])]
      end
    end
  end

  # 2. WORKERS - Iteración por todos los worker
  if NUM_WORKER_NODES > 0
    (1..NUM_WORKER_NODES).each do |i|
      config.vm.define "worker0#{i}" do |worker|
        worker.vm.hostname = "worker0#{i}"
        worker.vm.network "private_network", ip: IP_NW + "#{IP_START + i}"

        worker.vm.provider "virtualbox" do |vb|
          vb.cpus = settings["nodes"]["workers"]["cpu"]
          vb.memory = settings["nodes"]["workers"]["memory"]
          if settings["cluster_name"] && settings["cluster_name"] != ""
            vb.customize ["modifyvm", :id, "--groups", ("/" + settings["cluster_name"] + "/workers")]
          end
        end

        # INTEGRACIÓN DE ANSIBLE:
        # Se ejecuta solo en el último worker para garantizar que todas las máquinas estén levantadas antes
        if i == NUM_WORKER_NODES
          worker.vm.provision "ansible" do |ansible|
            ansible.playbook = "../ansible/playbooks/bootstrap_k8s.yaml"
            ansible.inventory_path = "../ansible/inventories/k8s_hosts.yaml"
            ansible.limit = "all" # Aplica el playbook a todos los grupos definidos en el inventario
            ansible.compatibility_mode = "2.0"
          end
        end
      end
    end
  end
end